# Порт, на котором поднимется единый сервер (API + статика фронтенда)
PORT=4000

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookmaker_sim

# Секрет для подписи JWT. Обязательно смените на длинную случайную строку в проде.
JWT_SECRET=change_me_to_a_long_random_string

# Сколько дней живёт сессия (JWT + cookie)
JWT_TTL_DAYS=30

# true -> коэффициенты генерируются моком локально, реальный API не дёргается
USE_MOCK_ODDS=true

# Ключ и базовый URL The Odds API (https://the-odds-api.com/) — нужны только если USE_MOCK_ODDS=false
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4

NODE_ENV=development
